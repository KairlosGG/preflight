          value: =Blank()

    - kind: SetVariable
      id: setVariable_Pexg1I
      displayName: P00 Solicitud inicial
      variable: Global.P00_SolicitudInicial
      value: =System.Activity.Text

    - kind: SendActivity
      id: sendActivity_gZBlU2
      displayName: Introducción
      activity: "Te haré 19 preguntas en cuatro bloques: identificación, valor, funcionamiento y riesgo. Son unos 5 minutos. Empezamos por la identificación."

    - kind: BeginDialog
      id: 01xfk9
      displayName: Ir a bloque A
      dialog: pft_AgentTower.topic.EntrevistaAIdentificacin

    - kind: BeginDialog
      id: pftGoSuf
      displayName: Ir a comprobar suficiencia
      dialog: pft_AgentTower.topic.Comprobarsuficiencia

    - kind: BeginDialog
      id: iHVnBV
      displayName: Ir a bloque B
      dialog: pft_AgentTower.topic.EntrevistaBValor

    - kind: BeginDialog
      id: QUKUkK
      displayName: Ir a bloque C
      dialog: pft_AgentTower.topic.EntrevistaCFuncionamiento

    - kind: BeginDialog
      id: pftGoD01
      displayName: Ir a bloque D
      dialog: pft_AgentTower.topic.EntrevistaDRiesgo

    - kind: BeginDialog
      id: pftGoClas
      displayName: Ir a clasificar riesgo
      dialog: pft_AgentTower.topic.Clasificarriesgo

    - kind: BeginDialog
      id: pftGoCoh
      displayName: Ir a revisar coherencia
      dialog: pft_AgentTower.topic.Revisarcoherencia

    - kind: SendActivity
      id: sendActivity_cyzR8L
      displayName: Cierre provisional
      activity: |-
        Clasificación preliminar de {Global.P01_NombreAgente} ({Global.P01_Area}):
        - Categoría: {Global.R_Categoria}
        - Zona propuesta: {Global.R_Zona}
        - Decisión por riesgo: {Global.R_DecisionRiesgo}
        - Referencias: {Global.R_Referencias}
        - Suficiencia: {Global.R_Suficiencia}
        - Detalle de suficiencia: {Global.R_SuficienciaDetalle}
        - Coherencia: {Global.R_Coherencia}
        - Detalle de coherencia: {Global.R_CoherenciaDetalle}
        - Versión de reglas: {Global.R_VersionReglas}
        - Versión del prompt: {Global.R_VersionPrompt}
        La ficha completa, con valor y coste, todavía está en construcción.
        _Orientación preliminar generada con IA. No constituye asesoramiento jurídico ni evaluación de conformidad. La clasificación debe validarla una persona responsable._

    - kind: SetVariable
      id: setVariable_cLXHDL
      displayName: Marcar como respondido
      variable: Topic.answered
      value: true

    - kind: CancelAllDialogs
      id: gDhKRN

inputType: {}
outputType:
  properties:
    answered:
      displayName: answered
      description: Verdadero si el usuario ya ha recibido en este tema la respuesta completa de la evaluación. No hay que volver a responderle.
      type: Boolean