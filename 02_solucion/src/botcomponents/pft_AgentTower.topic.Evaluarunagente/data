          value: =Blank()

        - variable: Global.R_Transparencia
          value: =Blank()

        - variable: Global.R_EIPD
          value: =Blank()

        - variable: Global.R_Art22
          value: =Blank()

        - variable: Global.R_Zona
          value: =Blank()

        - variable: Global.R_DecisionRiesgo
          value: =Blank()

